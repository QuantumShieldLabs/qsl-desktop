{
 "scenario": "na0776_gui_t_build_identity_visible",
 "destructive": true,
 "steps": [
  {
   "op": "launch"
  },
  {
   "op": "type",
   "sel": "#vault-pass",
   "text": "na0776-ft-passphrase"
  },
  {
   "op": "type",
   "sel": "#vault-confirm",
   "text": "na0776-ft-passphrase"
  },
  {
   "op": "prop_eq",
   "sel": "#btn-vault-create",
   "prop": "disabled",
   "expect": false,
   "poll": 5
  },
  {
   "op": "click",
   "sel": "#btn-vault-create"
  },
  {
   "op": "poll_visible",
